{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Web (Vite)",
      "runtimeExecutable": "/opt/homebrew/Cellar/node/25.2.1/bin/node",
      "runtimeArgs": ["node_modules/vite/bin/vite.js"],
      "cwd": "apps/web",
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Admin (Vite)",
      "runtimeExecutable": "/opt/homebrew/Cellar/node/25.2.1/bin/node",
      "runtimeArgs": ["node_modules/vite/bin/vite.js", "--port", "5174"],
      "cwd": "apps/admin",
      "port": 5174
    },
    {
      "name": "API (FastAPI)",
      "runtimeExecutable": "/opt/homebrew/bin/python3.13",
      "runtimeArgs": ["run_api.py"],
      "port": 3000
    },
    {
      "name": "Worker (Celery)",
      "runtimeExecutable": "celery",
      "runtimeArgs": ["-A", "workers.celery.tasks", "worker", "--loglevel=INFO"],
      "port": null
    },
    {
      "name": "Beat (Celery Scheduler)",
      "runtimeExecutable": "celery",
      "runtimeArgs": ["-A", "workers.celery.tasks", "beat", "--loglevel=INFO"],
      "port": null
    }
  ]
}

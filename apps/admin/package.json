{
  "name": "persona-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "test:mobile-contract": "node scripts/mobile-contract.test.mjs",
    "test:e2e:mobile": "playwright test -c playwright.config.mjs",
    "check:token-drift": "node scripts/check-token-drift.mjs",
    "check:premerge": "npm run test:mobile-contract && npm run check:token-drift && npm run build",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^18.3.6",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}

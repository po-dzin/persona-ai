{
  "name": "live-photo-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y-smoke": "vitest run src/__tests__/a11y.smoke.test.tsx",
    "check:token-drift": "node scripts/check-token-drift.mjs",
    "check:contracts": "tsc -p tsconfig.contracts.json --noEmit",
    "check:ui-gates": "npm run check:token-drift && npm run check:contracts && npm run test:a11y-smoke",
    "check:premerge": "npm run check:ui-gates && npm run test && npm run build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.6",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^29.0.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.8"
  }
}

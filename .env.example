# Runtime mode
# For real deploy: APP_ENV=prod and INTEGRATION_MODE=real
APP_ENV=dev
INTEGRATION_MODE=mock
# For free demo without a persistent worker/queue: FREE_DEMO_MODE=true
FREE_DEMO_MODE=false

# Core runtime
API_PORT=8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/live_photo
REDIS_URL=redis://localhost:6379/0

# Storage (R2)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=live-photo
R2_ACCESS_KEY_ID=replace
R2_SECRET_ACCESS_KEY=replace
R2_PUBLIC_BASE_URL=https://cdn.example.com

# AI providers (official-only Phase 1)
NANO_BANANA_API_KEY=replace
STABILITY_API_KEY=replace
BFL_API_KEY=replace
OPENAI_API_KEY=replace
RECRAFT_API_KEY=replace
PROVIDER_WEBHOOK_SECRET=replace
NANO_BANANA_API_URL=https://api.nanobanana.example/v1/generate
STABILITY_API_URL=https://api.stability.ai/v2beta/stable-image/generate/core
# For real deploy: PROVIDER_REAL_CALLS_ENABLED=true
PROVIDER_REAL_CALLS_ENABLED=false
PROVIDER_REQUEST_TIMEOUT_SECONDS=45

# Telegram (Mini App + Stars)
TELEGRAM_BOT_TOKEN=replace
TELEGRAM_WEBHOOK_SECRET=replace
TELEGRAM_MINIAPP_URL=https://personai-miniapp.onrender.com

# Stripe (Phase 2 backlog, keep empty for Phase 1)
STRIPE_SECRET_KEY=replace
STRIPE_WEBHOOK_SECRET=replace
STRIPE_PRICE_ID_STARTER=replace
STRIPE_PRICE_ID_BASIC=replace
STRIPE_PRICE_ID_POPULAR=replace
STRIPE_PRICE_ID_PRO=replace
STRIPE_PRICE_ID_ULTRA=replace

# Product constants (photo-first v59)
SLA_SECONDS_MIN=30
SLA_SECONDS_MAX=120
SOURCE_RETENTION_HOURS=48
RESULT_RETENTION_DAYS=30
BASE_GEN_USD=0.25
